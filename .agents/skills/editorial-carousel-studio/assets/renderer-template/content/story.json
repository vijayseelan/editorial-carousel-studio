    {
      "id": "05-scenario", "type": "scenarioBars", "format": "mp4",
      "label": "SCENARIO SIMULATION", "title": ["Let variables change", "the outcome."],
      "body": ["Start with a baseline. Transfer quantities.", "Then expose uncertainty."],
      "motion": {"durationSeconds": 12, "introSeconds": 0.6, "finalHoldSeconds": 2.0},
      "scenario": {
        "unit": "votes", "maxValue": 65000,
        "series": [
          {"id":"a","label":"GROUP A","colorRole":"gold"},
          {"id":"b","label":"GROUP B","colorRole":"accent"},
          {"id":"c","label":"GROUP C","colorRole":"foreground"}
        ],
        "steps": [
          {
            "label":"MEASURED BASELINE", "note":"Start with observed counts on a common scale.",
            "bars":[
              {"id":"a","segments":[{"id":"base-a","value":42000,"certainty":"known","colorRole":"gold"}]},
              {"id":"b","segments":[{"id":"base-b","value":36000,"certainty":"known","colorRole":"accent"}]},
              {"id":"c","segments":[{"id":"base-c","value":22000,"certainty":"known","colorRole":"foreground"}]}
            ],
            "callout":"Observed counts are facts; the later transfers are scenarios."
          },
          {
            "label":"TRANSFER ASSUMPTION", "note":"Move a defined quantity without pretending every unit follows.",
            "bars":[
              {"id":"a","segments":[{"id":"base-a","value":42000,"certainty":"known","colorRole":"gold"},{"id":"from-c","value":12000,"certainty":"estimated","colorRole":"foreground"}]},
              {"id":"b","segments":[{"id":"base-b","value":36000,"certainty":"known","colorRole":"accent"}]},
              {"id":"c","segments":[{"id":"base-c","value":10000,"certainty":"estimated","colorRole":"foreground"}]}
            ],
            "callout":"Scenario: 12,000 units move from C to A."
          },
          {
            "label":"SENSITIVITY RANGE", "note":"Show the plausible low–high interval, not one false-precision answer.",
            "bars":[
              {"id":"a","totalLabel":"50k–60k","segments":[{"id":"base-a","value":42000,"certainty":"known","colorRole":"gold"},{"id":"from-c","min":8000,"max":18000,"range":true,"certainty":"uncertain","colorRole":"foreground"}]},
              {"id":"b","segments":[{"id":"base-b","value":36000,"certainty":"known","colorRole":"accent"}]},
              {"id":"c","totalLabel":"4k–14k","segments":[{"id":"base-c","min":4000,"max":14000,"range":true,"certainty":"uncertain","colorRole":"foreground"}]}
            ],
            "callout":"The ranking may persist, reverse, or remain too close to call."
          }
        ]
      },
      "claimIds":["C005"], "visualSemantics":"process",
      "visualDisclaimer":"SCENARIO, NOT FORECAST · SOLID = OBSERVED · STRIPED = UNCERTAIN",
      "visualElements":["baseline","transfer","recomputed-totals","uncertainty-range","step-counter"],
      "storyboardIntent":{"requiredStatements":["variables change","uncertainty"],"requiredVisuals":["baseline","transfer","recomputed-totals","uncertainty-range","step-counter"]},
      "source":"Illustrative scenario mechanics · C005"
